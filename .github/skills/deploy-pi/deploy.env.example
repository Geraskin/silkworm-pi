# Copy this file to deploy.env and fill in your own values:
#
#     cp deploy.env.example deploy.env
#
# deploy.env is gitignored, so your address and key path stay out of the
# repository. Every value below is optional - anything you leave out falls back
# to the generic default in scripts/deploy.sh.

# SSH address of the Raspberry Pi.
# Use an IP address if *.local does not resolve from your dev container;
# mDNS does not cross the Docker bridge.
SSH_TARGET="pi@raspberrypi.local"

# Private key that can log in to the Pi.
SSH_KEY="$HOME/.ssh/id_ed25519"

# App folder on the Pi.
REMOTE_DIR="~/camweb"

# Files uploaded on every deploy (space-separated).
APP_FILES="app_v2.py camera.py"

# Entry point started by the fallback path when systemd is unavailable.
MAIN_MODULE="app_v2.py"

# systemd service that runs the app.
SERVICE_NAME="camweb"

# Health check URL. Derived from SSH_TARGET when not set.
# HEALTH_URL="http://192.168.1.50:8080/"
